{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "state/**",
    "dist/**",
    "build/**",
    ".wrangler/**",
    ".openai/**",
    "drizzle/**",
    "migrations/**",
    "tests/fixtures/**",
    "package-lock.json"
  ]
}
