# 复制为 .env；进程环境变量 > .env > 默认值，显式CLI参数优先。
# 相对路径以仓库根目录为准；支持 ${VAR}，不执行shell或反斜杠转义。
RE_WECHAT_HOST=127.0.0.1
RE_WECHAT_HOOK_PORT=30001
RE_WECHAT_MCP_PORT=30002
RE_WECHAT_PYTHON=wechat_codex/state/sdk-env/Scripts/python.exe
RE_WECHAT_HOOK_STATE_DIR=client_hook/state/mcp-live-validation
RE_WECHAT_MCP_STATE_DIR=wechat_mcp/state/live
# MCP朋友圈策略使用该状态目录的sns-policy.json（示例wechat_mcp/sns.example.json），不使用Hook环境开关。
RE_WECHAT_CODEX_STATE_DIR=wechat_codex/state/live
DAILY_DIGEST_STATE_DIR=daily_digest/state/live
DAILY_DIGEST_PREVIEW_PORT=4173
DAILY_DIGEST_PREVIEW_DB=daily_digest/web/state/preview.sqlite
# SSH发布目标；自动任务使用专用密钥，禁止交互等待或在HTTP中传输写凭据。
DAILY_DIGEST_DEPLOY_HOST=
DAILY_DIGEST_DEPLOY_USER=root
# 留空默认 ~/.ssh/webot_daily_digest_ed25519，路径相对仓库根解析。
DAILY_DIGEST_DEPLOY_IDENTITY_FILE=
# 模型时限在该状态目录config.json配置，单位秒（不使用环境变量）：
# startup_timeout=60, decision_timeout=60, reasoning_timeout=180, generation_idle_timeout=30, tool_timeout=60, turn_timeout=600
# 留空沿用Codex运行时默认；本机绝对路径填写到不提交的.env。
RE_WECHAT_CODEX_BIN=
CONTENT_CACHE_DIR=tool/state/cache
CONTENT_MODEL_DIR=tool/state/models/faster-whisper-small
CONTENT_BROWSER_PROFILE_DIR=wechat_codex/state/live/browser-profile
CONTENT_BROWSER_CHANNEL=msedge
# 可选网页UA；留空时浏览器使用安装版本的桌面UA，HTTP尝试读取Windows浏览器版本。
CONTENT_WEB_USER_AGENT=
# 第三方平台MCP独立环境与本机服务；仅卡片正文读取时调用。
CONTENT_PLATFORM_MCP_PYTHON=tool/state/platform-mcp/venv/Scripts/python.exe
CONTENT_BILIBILI_MCP_SCRIPT=tool/state/platform-mcp/bilibili-mcp/mcp_server.py
CONTENT_XIAOHONGSHU_MCP_URL=http://127.0.0.1:18060/mcp
# 构建/诊断工具，留空使用PATH中的同名程序。
RE_WECHAT_GCC=
RE_WECHAT_OBJDUMP=
RE_WECHAT_NM=
RE_WECHAT_WEIXIN_DLL=

# 日报配图：在 DAILY_DIGEST_STATE_DIR/config.json 设置 image_search_budget_seconds，默认300。
# 媒体缓存随每次生成目录保存，无需额外图片代理地址或密钥。
