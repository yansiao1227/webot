# 复制为 .env；进程环境变量 > .env > 默认值，显式CLI参数优先。
# 相对路径以仓库根目录为准；支持 ${VAR}，不执行shell或反斜杠转义。
RE_WECHAT_HOST=127.0.0.1
RE_WECHAT_HOOK_PORT=30001
RE_WECHAT_MCP_PORT=30002
RE_WECHAT_PYTHON=wechat_codex/state/sdk-env/Scripts/python.exe
RE_WECHAT_HOOK_STATE_DIR=client_hook/state/mcp-live-validation
RE_WECHAT_MCP_STATE_DIR=wechat_mcp/state/live
RE_WECHAT_CODEX_STATE_DIR=wechat_codex/state/live
# 模型时限在该状态目录config.json配置，单位秒（不使用环境变量）：
# startup_timeout=60, decision_timeout=30, generation_idle_timeout=30, tool_timeout=60, turn_timeout=600
# 留空沿用Codex运行时默认；本机绝对路径填写到不提交的.env。
RE_WECHAT_CODEX_BIN=
CONTENT_CACHE_DIR=tool/state/cache
CONTENT_MODEL_DIR=tool/state/models/faster-whisper-small
CONTENT_BROWSER_PROFILE_DIR=wechat_codex/state/live/browser-profile
CONTENT_BROWSER_CHANNEL=msedge
# 可选网页UA；留空时浏览器使用安装版本的桌面UA，HTTP尝试读取Windows浏览器版本。
CONTENT_WEB_USER_AGENT=
# 构建/诊断工具，留空使用PATH中的同名程序。
RE_WECHAT_GCC=
RE_WECHAT_OBJDUMP=
RE_WECHAT_NM=
RE_WECHAT_WEIXIN_DLL=
